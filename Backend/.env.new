# ===========================================
# SOC DASHBOARD BACKEND CONFIGURATION
# ===========================================

# Environment
NODE_ENV=development

# SECURITY FIX (PATCH 41): Error Handling Configuration (CWE-209)
# EXPOSE_ERROR_DETAILS: Set to 'false' in UAT/Production to hide stack traces
# Even in development mode, sensitive environments should hide error details
EXPOSE_ERROR_DETAILS=false

# Server Configuration
PORT=5000
HOST=localhost

# HTTPS/SSL Configuration
# Set to 'true' to enable HTTPS (required for production)
ENABLE_HTTPS=false

# SSL Certificate Paths (only needed if ENABLE_HTTPS=true)
# Use absolute paths or paths relative to Backend directory
# SSL_KEY_PATH=./certs/server.key
# SSL_CERT_PATH=./certs/server.cert
# SSL_CA_PATH=./certs/ca-bundle.crt

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/soc_dashboard

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# JWT Secrets (512-bit cryptographically secure random keys)
# IMPORTANT: Keep these secrets safe! Changing them will invalidate all existing tokens.
# DO NOT share or commit these keys to version control.
JWT_SECRET=d808041f41377c9cd6150d53f50af631a03a1cae46d6f6d27cdc46b86c07c855dd9b05ebf3989bab7f6740f999c87049b63849a6c0a0eb20bf4b18e174639915
JWT_REFRESH_SECRET=ea791b953a3732e6f1c64f73b386ba23ab1849798f2f4fe98520eb4b7d89d05dc11dd93952f6f4818600fd11701cca0167ae044f7ec76c5133addce196b0e762

# JWT Expiration Times
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=7d

# SECURITY FIX (PATCH 40): Session Timeout Configuration (CWE-613)
# SESSION_INACTIVITY_TIMEOUT: Minutes of inactivity before session expires (default: 15)
# SESSION_ABSOLUTE_TIMEOUT: Maximum session lifetime in hours (default: 1)
# Recommended: 15-30 minutes inactivity, 1-4 hours absolute
SESSION_INACTIVITY_TIMEOUT=15
SESSION_ABSOLUTE_TIMEOUT=1

# SECURITY FIX (PATCH 54): Concurrent Session Prevention (CWE-1018)
# ALLOW_CONCURRENT_SESSIONS: Allow multiple simultaneous logins (true/false)
# MAX_CONCURRENT_SESSIONS: Maximum number of concurrent sessions per user (0 = unlimited)
# Set ALLOW_CONCURRENT_SESSIONS=false to enforce single session per user
ALLOW_CONCURRENT_SESSIONS=false
MAX_CONCURRENT_SESSIONS=1

# Password Security
BCRYPT_ROUNDS=12

# Encryption Key (For sensitive data encryption - 256-bit cryptographically secure)
# IMPORTANT: This key is used for encrypting sensitive data. Keep it secret!
# DO NOT share or commit this key to version control.
ENCRYPTION_KEY=f389d5d61825b07f48628a59d61f08d8fced31259f2a0ac62aad344aa9626b32

# ===========================================
# CORS & SECURITY
# ===========================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# SECURITY FIX (PATCH 53): Google reCAPTCHA Enterprise Configuration (CWE-306)
# reCAPTCHA Enterprise protects login endpoint from automated attacks
RECAPTCHA_PROJECT_ID=codecnet-1762237741353
RECAPTCHA_SITE_KEY=6LduqwEsAAAAAKlnlc0xFDUEvMrwNy6lxls37b3x
RECAPTCHA_THRESHOLD=0.5

# ===========================================
# EXTERNAL API INTEGRATIONS
# ===========================================

# AlienVault OTX API
ALIEN_VAULT_OTX_API_KEY=49cc8c3309309921571cc4bed443c16edf15f3a430fee9b25af8297ed561eeb8

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# File Upload Limits
MAX_FILE_SIZE=10485760

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================

# Development flags
ENABLE_CORS=true
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_STACK_TRACE=true

