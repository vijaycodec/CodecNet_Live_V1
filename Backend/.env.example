SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeThisPassword123!
SEED_SUPERADMIN_FULLNAME=Super Administrator
SEED_SUPERADMIN_PHONE=+1234567890

SEED_ANALYST_USERNAME=analyst
SEED_ANALYST_EMAIL=analyst@example.com
SEED_ANALYST_PASSWORD=ChangeThisPassword123!
SEED_ANALYST_FULLNAME=Security Analyst
SEED_ANALYST_PHONE=+1234567893

