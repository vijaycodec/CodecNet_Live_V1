# Organization 2: FinanceSecure
ORG2_CLIENT_NAME=FinanceSecure
ORG2_ORGANISATION_NAME=Global Finance Corp
ORG2_INDUSTRY=Financial Services
ORG2_SUBSCRIPTION_PLAN=ENT
ORG2_EMAIL_1=security@example.com
ORG2_PHONE_1=+1234567810
ORG2_TIMEZONE=America/Chicago
ORG2_LOCALE=en-US
ORG2_WAZUH_MANAGER_IP=127.0.0.1
ORG2_WAZUH_MANAGER_PORT=55000
ORG2_WAZUH_MANAGER_USERNAME=wazuh
ORG2_WAZUH_MANAGER_PASSWORD=change_this_password
ORG2_WAZUH_INDEXER_IP=127.0.0.1
ORG2_WAZUH_INDEXER_PORT=9200
ORG2_WAZUH_INDEXER_USERNAME=admin
ORG2_WAZUH_INDEXER_PASSWORD=change_this_password
ORG2_WAZUH_DASHBOARD_IP=127.0.0.1
ORG2_WAZUH_DASHBOARD_PORT=443
ORG2_WAZUH_DASHBOARD_USERNAME=admin
ORG2_WAZUH_DASHBOARD_PASSWORD=change_this_password

# ===========================================
# CRITICAL ALERT EMAIL NOTIFICATIONS (Hostinger SMTP)
# ===========================================

# Enable / disable automatic critical-alert emails (true|false)
ALERT_EMAIL_ENABLED=true

# Hostinger SMTP server
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# Sender (FROM) - per spec
ALERT_SENDER_NAME=CodecNet SOC Services
ALERT_SENDER_EMAIL=cnsocservices@codecnetworks.in
# IMPORTANT: If your password contains '#', '$', spaces, or other special chars,
# wrap the value in double quotes - dotenv treats '#' as a comment delimiter otherwise.
ALERT_SENDER_PASSWORD="your_hostinger_mailbox_password"

# Default CC - OPTIONAL. When empty, no system-wide CC is auto-added; only the
# per-organisation cc_emails[] list is used. Leave blank unless you specifically
# want every critical-alert email CC'd to a fixed mailbox.
ALERT_DEFAULT_CC=

# Fallback TO recipient used when an organisation has no Contact emails configured
ALERT_FALLBACK_TO=seo@codecnetworks.in

# Wazuh rule.level threshold to treat as a Critical alert (default: 12)
CRITICAL_LEVEL_THRESHOLD=12

# Timezone used to format alert times in email body
ALERT_EMAIL_TZ=Asia/Kolkata

# Escalation contacts shown in the alert email footer. All optional —
# rows are hidden when blank; the whole "Escalation Contacts" box is
# omitted if every value below is empty. SOC_EMAIL defaults to
# soc@codecnetworks.in when unset.
SOC_HOTLINE=XXXXXXXX90
SOC_EMAIL=soc@codecnetworks.in
SOC_INCIDENT_MANAGER=Bhasker
SOC_ACCOUNT_SDM=TEST USER

# ===========================================
# LLM (LM STUDIO) - ALERT NARRATIVE GENERATION
# ===========================================
# Used to auto-generate the SOC ANALYSIS, RECOMMENDED ACTIONS (CLIENT),
# and COMPLIANCE & REPORTING sections of the critical-alert email.
# If the LLM is unreachable/times out, the email is still sent without
# these sections (the alert is never blocked on LLM availability).

# Enable / disable LLM narrative generation (true|false)
LLM_ANALYSIS_ENABLED=true

# Base URL of your LM Studio server (no trailing slash, no /v1).
# LM Studio exposes an OpenAI-compatible API at <base>/v1/chat/completions.
LLM_BASE_URL=http://192.168.3.50:1234

# Model identifier sent in the API request. MUST be set explicitly - LM Studio
# does NOT auto-select a model when this is blank, requests will hang.
# Run  curl http://<lm-studio-host>:1234/v1/models  to see available IDs.
# meta-llama-3.1-8b-instruct works well for JSON-schema-constrained SOC output.
LLM_MODEL=meta-llama-3.1-8b-instruct

# Optional API key. LM Studio does not require one by default; leave blank.
LLM_API_KEY=

# Timeout in milliseconds for the LLM request. Cold-start on an 8B model
# over LAN typically completes in ~50s; 120s gives safe headroom.
LLM_TIMEOUT_MS=120000

# Sampling temperature (0.0 = deterministic, 1.0 = very creative).
# Keep low for SOC analysis where you want grounded, factual output.
LLM_TEMPERATURE=0.3

# Max tokens for the LLM response (covers all 3 sections together).
LLM_MAX_TOKENS=1500
